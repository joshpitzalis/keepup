  "devDependencies": {
    "@oxlint/plugins": "1.88.0",
    "@types/node": "^24.19.2",
    "effect": "4.0.5",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "typescript": "^7.0.2",
    "ultracite": "8.0.1"
  },
  "engines": {
    "node": ">=24.8.0"
  }
}
